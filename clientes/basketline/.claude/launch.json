{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "basketline",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "demo",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "basketline-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "demo",
        "run",
        "start",
        "--",
        "-H",
        "0.0.0.0"
      ],
      "port": 3000
    },
    {
      "name": "basketline-etapa2",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd demo&& set NEXT_DIST_DIR=.next-etapa2&& set BANCO_MODO=demo&& npx next dev -H 0.0.0.0 -p 3100"
      ],
      "port": 3100
    }
  ]
}
